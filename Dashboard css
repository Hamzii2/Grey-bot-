* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

body {
  background: #fff8f0;
  color: #3b1f0f;
}

/* Dashboard Layout */
.dashboard {
  display: flex;
  min-height: 100vh;
}

/* Sidebar */
.sidebar {
  width: 260px;
  background: #5c3317;
  color: white;
  padding: 30px 20px;
}

.sidebar h2 {
  color: #d4af37;
  margin-bottom: 40px;
  text-align: center;
}

.sidebar a {
  display: block;
  color: white;
  text-decoration: none;
  padding: 15px;
  margin-bottom: 10px;
  border-radius: 10px;
}

.sidebar a:hover {
  background: #d4af37;
  color: #3b1f0f;
}

/* Main Content */
.main {
  flex: 1;
  padding: 30px;
}

/* Top Bar */
.topbar {
  background: white;
  padding: 20px;
  border-radius: 15px;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

/* Cards */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 25px;
  margin-top: 30px;
}

.card {
  background: white;
  padding: 25px;
  border-radius: 15px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.1);
}

.card h3 {
  margin-bottom: 15px;
}

.card span {
  font-size: 30px;
  font-weight: bold;
  color: #d4af37;
}

/* Orders Table */
.table-box {
  background: white;
  margin-top: 30px;
  padding: 25px;
  border-radius: 15px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 15px;
  text-align: left;
  border-bottom: 1px solid #ddd;
}

th {
  background: #5c3317;
  color: white;
}

/* Buttons */
button {
  background: #d4af37;
  color: #3b1f0f;
  border: none;
  padding: 12px 25px;
  border-radius: 25px;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  background: #5c3317;
  color: white;
}

/* Mobile */
@media(max-width:768px){
  .dashboard {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }
}
