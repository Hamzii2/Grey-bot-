<!DOCTYPE html>
<html>
<head>
    <title>Taste Heavens Login</title>
    <link rel="stylesheet" href="auth.css">
</head>

<body>

<div class="auth-box">

    <h2>Login</h2>

    <form id="loginForm">

        <input 
        type="email" 
        id="email" 
        placeholder="Email"
        required>

        <input 
        type="password" 
        id="password" 
        placeholder="Password"
        required>

        <button type="submit">
            Login
        </button>

    </form>

    <p>
        Don't have an account?
        <a href="signup.html">Sign up</a>
    </p>

</div>


<script src="auth.js"></script>

</body>
</html>
