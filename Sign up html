<!DOCTYPE html>
<html>
<head>
    <title>Taste Heavens Signup</title>
    <link rel="stylesheet" href="auth.css">
</head>

<body>

<div class="auth-box">

    <h2>Create Account</h2>

    <form id="signupForm">

        <input 
        type="text" 
        id="username" 
        placeholder="Full Name"
        required>

        <input 
        type="email" 
        id="signupEmail" 
        placeholder="Email"
        required>

        <input 
        type="password" 
        id="signupPassword" 
        placeholder="Password"
        required>

        <button type="submit">
            Sign Up
        </button>

    </form>


    <p>
        Already have an account?
        <a href="login.html">Login</a>
    </p>

</div>


<script src="auth.js"></script>

</body>
</html>
