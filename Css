/* Google Font */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#0f172a;
    color:#fff;
}

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 8%;
    position:fixed;
    width:100%;
    top:0;
    left:0;
    background:rgba(15,23,42,.9);
    backdrop-filter:blur(10px);
    z-index:1000;
}

header h1{
    color:#22c55e;
    font-size:32px;
    font-weight:700;
}

header p{
    color:#cbd5e1;
    font-size:14px;
}

.hero{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:120px 20px;
    background:linear-gradient(135deg,#0f172a,#1e293b);
}

.hero h2{
    font-size:60px;
    max-width:900px;
    line-height:1.2;
    margin-bottom:20px;
}

.hero p{
    font-size:20px;
    color:#cbd5e1;
    max-width:700px;
    margin-bottom:40px;
}

button{
    padding:16px 40px;
    border:none;
    border-radius:50px;
    background:#22c55e;
    color:#fff;
    font-size:18px;
    cursor:pointer;
    transition:.3s;
}

